# PostgreSQL — django-environ lê este único valor (postgres:// => psycopg 3).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Opcionais (têm defaults de desenvolvimento no settings.py):
# DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-em-producao
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
